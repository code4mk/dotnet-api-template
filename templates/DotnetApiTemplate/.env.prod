# Production preset. On the server: cp .env.prod .env, then replace every change-me value.
# Not committed. Real environment variables (platform, secret store) always win over .env.

# Project environment: dev | stage | prod (maps to Development | Staging | Production)
APP_ENV=prod

# PostgreSQL. With Docker Compose the API always connects to db:5432;
# set DB_HOST/DB_PORT to your database server when the API runs outside Compose.
DB_HOST=db
DB_PORT=5432
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=change-me

# Host port for the API container (the container listens on 8080).
API_PORT=18080

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me
# Optional, with defaults: JWT_ISSUER=DotnetApiTemplate, JWT_AUDIENCE=DotnetApiTemplate, JWT_EXPIRY_MINUTES=60

# Email (SMTP) through your provider. Leave EMAIL_HOST empty to only log emails.
# TLS: implicit on port 465, STARTTLS on other ports (EMAIL_ENABLE_SSL=true).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=change-me
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=DotnetApiTemplate
