<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>DotnetApiTemplate.Api</RootNamespace>
    <!-- The API serves no wwwroot/static web assets (Swagger UI and the Hangfire dashboard ship their own files).
         Off, so `dotnet watch` doesn't look for their dev manifest (on macOS/Linux it fails with "obj\Debug/..."). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <UserSecretsId>4f6c2a8e-1b3d-4e5f-9a7b-2c8d0e1f3a5b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Scriban" />
    <PackageReference Include="PreMailer.Net" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Email templates and styles are embedded in the assembly by file name (see Infrastructure/Email). -->
    <EmbeddedResource Include="**/*.scriban;Infrastructure/Email/Layout/*.css" Exclude="bin/**;obj/**"
                      LogicalName="email-templates/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Http.HttpResults" />
    <InternalsVisibleTo Include="DotnetApiTemplate.UnitTests" />
    <InternalsVisibleTo Include="DotnetApiTemplate.IntegrationTests" />
  </ItemGroup>

</Project>
