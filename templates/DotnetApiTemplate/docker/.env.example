# Copy to .env (never commit .env).

DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
# Host port for PostgreSQL. Picked per project so it doesn't clash with other Postgres containers.
# If you change it, update the port in src/DotnetApiTemplate.Api/appsettings.Development.json too.
DB_PORT=54320

# Host port for the API when it runs in Docker (inside the container it listens on 8080).
API_PORT=18080

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-chars

# Development seed user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
