{
  "$schema": "http://json.schemastore.org/template",
  "author": "Code4mk",
  "classifications": ["Web", "API", "Minimal API", "Solution"],
  "identity": "Code4mk.MinimalApi.Template",
  "name": "Code4mk ASP.NET Core API Template",
  "description": "ASP.NET Core Minimal API solution with feature folders, service layer, EF Core (PostgreSQL), JWT auth, Docker, tests and docs.",
  "shortName": "dotnet-api-template",
  "sourceName": "DotnetApiTemplate",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "guids": [
    "B9BE3F8C-6685-44CF-9583-A9DF291682DC",
    "93F0257E-87DF-4DD4-A882-B8C78BB5BEEA",
    "FF09C328-0507-493D-B21E-5ED5DA33856C",
    "4F6C2A8E-1B3D-4E5F-9A7B-2C8D0E1F3A5B"
  ],
  "forms": {
    "nonAlphanumericToDash": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9]+",
      "replacement": "-"
    },
    "lowerInvariant": {
      "identifier": "lowerCaseInvariant"
    },
    "slug": {
      "identifier": "chain",
      "steps": ["nonAlphanumericToDash", "lowerInvariant"]
    }
  },
  "symbols": {
    "autoDiscovery": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Find feature endpoints (IEndpoints) and services (XService : IXService) automatically instead of registering them by hand."
    },
    "autoDiscoverySwitch": {
      "type": "generated",
      "generator": "switch",
      "replaces": "AutoDiscovery = false",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(autoDiscovery)", "value": "AutoDiscovery = true" },
          { "condition": "(!autoDiscovery)", "value": "AutoDiscovery = false" }
        ]
      }
    },
    "projectSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "dotnetapitemplate-slug",
      "description": "Lowercase, dash-separated name used for Docker image and Compose project names."
    },
    "dbHostPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 54300,
        "high": 54999
      },
      "replaces": "54320",
      "description": "Free host port for the PostgreSQL container, so projects don't clash with other databases on 5432."
    },
    "apiHostPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 18000,
        "high": 18999
      },
      "replaces": "18080",
      "description": "Free host port for the API container, so projects don't clash with other services on 8080."
    },
    "mailSmtpHostPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 21000,
        "high": 21999
      },
      "replaces": "21025",
      "description": "Free host port for Mailpit SMTP (local development email)."
    },
    "mailUiHostPort": {
      "type": "generated",
      "generator": "port",
      "parameters": {
        "low": 28000,
        "high": 28999
      },
      "replaces": "28025",
      "description": "Free host port for the Mailpit web inbox."
    }
  },
  "sources": [
    {
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/.git/**"
      ],
      "modifiers": [
        {
          "exclude": [
            "**/[Bb]in/**",
            "**/[Oo]bj/**",
            "**/.vs/**",
            "**/.idea/**",
            "**/*.user",
            "**/TestResults/**",
            ".git/**",
            ".template.config/**",
            ".env",
            ".env.dev",
            ".env.stage",
            ".env.prod",
            ".env.local"
          ]
        }
      ]
    }
  ]
}
