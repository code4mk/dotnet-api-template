# Active environment file: the API and Docker Compose read only this file.
# Start from .env.example or a preset: cp .env.dev .env  (or .env.prod on a server). Never commit it.

# Project environment: dev | stage | prod (maps to Development | Staging | Production)
APP_ENV=dev

# PostgreSQL. DB_HOST/DB_PORT are used when the API runs on your machine;
# inside Docker Compose the API always connects to db:5432.
# DB_PORT is also the host port Docker publishes PostgreSQL on (picked per project).
DB_HOST=localhost
DB_PORT=54320
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres

# Host port for the API when it runs in Docker (the container listens on 8080).
API_PORT=18080

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=development-only-signing-key-change-me-0123456789
# Optional, with defaults: JWT_ISSUER=DotnetApiTemplate, JWT_AUDIENCE=DotnetApiTemplate, JWT_EXPIRY_MINUTES=60

# Email (SMTP). Leave EMAIL_HOST empty to log emails instead of sending them.
# Optional, with defaults: EMAIL_PORT=587, EMAIL_ENABLE_SSL=true, EMAIL_FROM=no-reply@dotnetapitemplate.local
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Admin user seeded in development
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
