# Example settings: the only env file committed to git. Copy it to start:
#   cp .env.example .env        (active settings, read by the API and Docker Compose)
#   cp .env.example .env.prod   (optional presets per environment; set APP_ENV and real values)
# Keep only placeholders and local-only defaults here, never real secrets.

# Project environment: dev | stage | prod (maps to Development | Staging | Production)
APP_ENV=dev

# What this process runs: all (API + background jobs, the default for development) | api | worker.
# The production image runs both roles in one container with supervisor and sets APP_ROLE per process.
APP_ROLE=all

# PostgreSQL. DB_HOST/DB_PORT are used when the API runs on your machine;
# inside Docker Compose the API always connects to db:5432.
# DB_PORT is also the host port Docker publishes PostgreSQL on (picked per project).
DB_HOST=localhost
DB_PORT=54320
DB_NAME=appdb
DB_USER=postgres
DB_PASSWORD=postgres
# Connections per process. With many instances keep instances x processes x this below max_connections.
DB_MAX_POOL_SIZE=100

# Host port for the API when it runs in Docker (the container listens on 8080).
API_PORT=18080

# Browser frontends allowed to call the API from another origin (CORS), comma-separated exact origins:
# scheme://host[:port], no paths or wildcards. Empty = no cross-origin browser access.
# Production: your real frontend URL(s), e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=development-only-signing-key-change-me-0123456789
# Optional, with defaults: JWT_ISSUER=DotnetApiTemplate, JWT_AUDIENCE=DotnetApiTemplate, JWT_EXPIRY_MINUTES=60

# Email (SMTP). Local development sends to Mailpit (docker compose up -d mailpit) and every
# email shows up in its inbox at http://localhost:28025. Leave EMAIL_HOST empty to only log emails.
# Optional, with defaults: EMAIL_FROM=no-reply@dotnetapitemplate.local, EMAIL_FROM_NAME=DotnetApiTemplate
EMAIL_HOST=localhost
EMAIL_PORT=21025
EMAIL_ENABLE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAILPIT_UI_PORT=28025

# Background jobs (Hangfire, stored in PostgreSQL schema "hangfire"; tables come from `dotnet ef database update`).
# Parallel jobs per worker process, queues (highest priority first), idle poll interval, graceful stop timeout.
JOBS_WORKER_COUNT=10
JOBS_QUEUES=default,emails
JOBS_POLL_INTERVAL_SECONDS=5
JOBS_SHUTDOWN_TIMEOUT_SECONDS=60
# Dashboard at /jobs: open in development; elsewhere served only when both are set (HTTP basic auth, use HTTPS).
JOBS_DASHBOARD_USERNAME=
JOBS_DASHBOARD_PASSWORD=
